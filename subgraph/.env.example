# Soroban direct indexer (Stellar-only). Do not commit real RPC tokens.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
PORT=4000
POLL_MS=30000
EVENT_LIMIT=100
# Docker compose default (service hostname `postgres`):
DATABASE_URL=postgres://fist:fist@postgres:5432/stellar_indexer
# Local host against published port 5433:
# DATABASE_URL=postgres://fist:fist@127.0.0.1:5433/stellar_indexer
# START_LEDGER=
# INDEX_TRACK_B=0
POSTGRES_PORT=5433
