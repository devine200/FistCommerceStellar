{
  "name": "@fist-commerce/stellar-subgraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "poll": "tsx src/poller.ts",
    "migrate": "tsx -e \"import { migrate, usingPostgres } from './src/db.ts'; if (!usingPostgres()) { console.log('DATABASE_URL unset'); process.exit(0); } await migrate(); console.log('ok');\""
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.0.0",
    "express": "^4.21.0",
    "graphql": "^16.9.0",
    "graphql-http": "^1.22.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
